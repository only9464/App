<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="heuopenresource.exe"
        Arguments=""
        InstallLocation="C:\Program Files\HEUOpenResource\HEUOpenResource">
    </Installer>
    <PackageInformation
        PackageName="HEUOpenResource"
        PackageDisplayName="HEUOpenResource"
        PublisherName="CN=HEUOpenResource"
        PublisherDisplayName="HEUOpenResource"
        Version="0.1.0.0"
        PackageDescription="HEUOpenResource">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.heuopenresource"
                Description="HEUOpenResource"
                DisplayName="HEUOpenResource"
                ExecutableName="heuopenresource.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>HEUOpenResource</DisplayName>
            <PublisherDisplayName>HEUOpenResource</PublisherDisplayName>
            <Description>HEUOpenResource</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="heuopenresource.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
